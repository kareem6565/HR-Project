POSTGRES_DB=hr_ai_assistant
POSTGRES_USER=hr_ai_assistant
POSTGRES_PASSWORD=change-me

# AI provider used by the composed stack.
# fake -> deterministic matcher, no API key, works offline (demo default)
# ollama -> Ollama Cloud (requires OLLAMA_API_KEY)
# soal -> Soal gateway (requires SOAL_API_KEY)
# gemini -> Google Gemini API (requires GEMINI_API_KEY)
# openrouter -> OpenRouter API (requires OPENROUTER_API_KEY)
AI_PROVIDER=fake
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gemma4:31b
SOAL_API_KEY=
SOAL_BASE_URL=https://soal.help/api/v1
SOAL_MODEL=gpt-5.6-sol
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.8-flash
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017:nitro
OPENROUTER_MAX_TOKENS=1024

# Must match HERA_SSO_SHARED_SECRET in the sibling HR manager/.env file.
HR_SSO_SHARED_SECRET=
HR_SSO_ISSUER=hr-manager

# Published ports for the frontends (host side)
FRONTEND_PORT=8080
HR_WEB_PORT=80
BACKEND_PORT=8001

# Secret key for JWT authentication tokens (generate a secure 32+ char key in production)
JWT_SECRET_KEY=change-me-to-a-secure-secret-key-min-32-chars
