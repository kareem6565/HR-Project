POSTGRES_DB=hr_ai_assistant
POSTGRES_USER=hr_ai_assistant
POSTGRES_PASSWORD=change-me

# AI provider used by the composed stack.
# fake -> deterministic matcher, no API key, works offline (demo default)
# ollama -> Ollama Cloud (requires OLLAMA_API_KEY)
# soal -> Soal gateway (requires SOAL_API_KEY)
AI_PROVIDER=fake
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gemma4:31b
SOAL_API_KEY=
SOAL_BASE_URL=https://soal.help/api/v1
SOAL_MODEL=gemini-3.5-flash

# Published port for the frontend (host side)
FRONTEND_PORT=8080

# Secret key for JWT authentication tokens (generate a secure 32+ char key in production)
JWT_SECRET_KEY=change-me-to-a-secure-secret-key-min-32-chars
