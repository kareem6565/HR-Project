# --- Application Configuration ---
APP_NAME="AI HR Recruitment Assistant"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Database ---
DATABASE_URL=postgresql+psycopg://hr_ai_assistant:hr_ai_assistant@localhost:5432/hr_ai_assistant
TEST_DATABASE_URL=postgresql+psycopg://hr_ai_assistant:hr_ai_assistant@localhost:5432/hr_ai_assistant_test

# --- Storage & File Limits ---
STORAGE_ROOT_DIR=./storage
MAX_UPLOAD_BYTES=5242880
MAX_BATCH_FILES=20
MAX_BATCH_BYTES=52428800
MAX_PDF_PAGES=50
MAX_DOCX_UNCOMPRESSED_BYTES=20971520
MAX_DOCX_ENTRIES=100

# --- CORS ---
CORS_ALLOW_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:5174", "http://127.0.0.1:5174", "http://localhost:8080"]
CORS_ALLOW_METHODS=["GET", "POST", "PATCH", "DELETE"]

# --- AI Provider ---
# ollama: live LLM evaluation via Ollama Cloud
# soal: live LLM evaluation via OpenAI-compatible Soal gateway
# openrouter: live LLM evaluation via OpenRouter's OpenAI-compatible API
# fake: deterministic offline mock
AI_PROVIDER=openrouter
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gemma4:31b
SOAL_API_KEY=
SOAL_BASE_URL=https://soal.help/api/v1
SOAL_MODEL=gemini-3.5-flash
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_MAX_TOKENS=4096
AI_FREE_MODEL_ALLOWLIST=
AI_PAID_MODE_ENABLED=false
AI_PAID_BUDGET_USD=0
# Baseline key usage when starting a bounded paid test; keep at 0 unless explicitly enabled.
AI_PAID_BUDGET_BASELINE_USD=0
AI_GLOBAL_RPM_LIMIT=15
AI_GLOBAL_DAILY_LIMIT=40
AI_USER_RPM_LIMIT=5
AI_USER_DAILY_LIMIT=20
AI_TESTER_USER_IDS=
AI_TESTER_USER_RPM_LIMIT=10
AI_TESTER_USER_DAILY_LIMIT=60

# --- Authentication & Security ---
# Must be set to a high-entropy secret (min 32 chars) in production
JWT_SECRET_KEY=change-me-to-a-secure-random-secret-key-32chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
JWT_ISSUER=hera-auth
JWT_AUDIENCE=hera-api
HR_SSO_SHARED_SECRET=
HR_SSO_ORGANIZATION_ID=
HR_SSO_ISSUER=hr-manager
# Local password login is disabled: the HR Manager is the single entry point.
ALLOW_LOCAL_LOGIN=false

# --- LinkedIn job import through Apify (disabled until explicitly enabled) ---
APIFY_API_TOKEN=
APIFY_LINKEDIN_JOBS_ACTOR_ID=fetch_cat/linkedin-jobs-scraper
APIFY_IMPORT_ENABLED=true

# --- Public Job Applications ---
# Explicit development-only text. Replace with owner-approved notice/version before production.
APPLICATION_PRIVACY_NOTICE_TEXT=TEST ONLY: Your information will be used to process this job application.
APPLICATION_PRIVACY_NOTICE_VERSION=local-test-v1
APPLICATION_PRIVACY_NOTICE_APPROVED=false
PUBLIC_APPLICATION_RATE_LIMIT=5
PUBLIC_APPLICATION_RATE_WINDOW_SECONDS=3600
TURNSTILE_REQUIRED=false
TURNSTILE_SECRET_KEY=

# --- Google Calendar / OAuth (EPIC 6) ---
# Encryption key for stored Google OAuth tokens (min 32 chars, required in production)
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_POST_LOGIN_REDIRECT_URI=
FRONTEND_BASE_URL=http://localhost:5174
# "google": require/create/update real Google Calendar events. "hera": dev-only fallback, clearly warned.
GOOGLE_CALENDAR_MODE=hera
GOOGLE_CALENDAR_ID=primary
