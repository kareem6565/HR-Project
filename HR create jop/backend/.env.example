# --- Application Configuration ---
APP_NAME="AI HR Recruitment Assistant"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Database ---
DATABASE_URL=postgresql+psycopg://hr_ai_assistant:hr_ai_assistant@localhost:5432/hr_ai_assistant
TEST_DATABASE_URL=postgresql+psycopg://hr_ai_assistant:hr_ai_assistant@localhost:5432/hr_ai_assistant_test

# --- Storage & File Limits ---
STORAGE_ROOT_DIR=./storage
MAX_UPLOAD_BYTES=5242880
MAX_BATCH_FILES=20
MAX_BATCH_BYTES=52428800
MAX_PDF_PAGES=50
MAX_DOCX_UNCOMPRESSED_BYTES=20971520
MAX_DOCX_ENTRIES=100

# --- CORS ---
CORS_ALLOW_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:5174", "http://127.0.0.1:5174", "http://localhost:8080"]
CORS_ALLOW_METHODS=["GET", "POST", "PATCH", "DELETE"]

# --- AI Provider ---
# ollama: live LLM evaluation via Ollama Cloud (primary)
# soal: live LLM evaluation via OpenAI-compatible Soal gateway (fallback)
# fake: deterministic offline mock; use ollama with OLLAMA_API_KEY for real screening
AI_PROVIDER=fake
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gemma4:31b
SOAL_API_KEY=
SOAL_BASE_URL=https://soal.help/api/v1
SOAL_MODEL=gemini-3.5-flash

# --- Authentication & Security ---
# Must be set to a high-entropy secret (min 32 chars) in production
JWT_SECRET_KEY=change-me-to-a-secure-random-secret-key-32chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
JWT_ISSUER=hera-auth
JWT_AUDIENCE=hera-api
HR_SSO_SHARED_SECRET=
HR_SSO_ORGANIZATION_ID=
HR_SSO_ISSUER=hr-manager
# Local password login is disabled: the HR Manager is the single entry point.
ALLOW_LOCAL_LOGIN=false

# --- Google Calendar / OAuth (EPIC 6) ---
# Encryption key for stored Google OAuth tokens (min 32 chars, required in production)
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_POST_LOGIN_REDIRECT_URI=
FRONTEND_BASE_URL=http://localhost:5174
# "google": require/create/update real Google Calendar events. "hera": dev-only fallback, clearly warned.
GOOGLE_CALENDAR_MODE=hera
GOOGLE_CALENDAR_ID=primary
