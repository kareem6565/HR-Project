# --- LLM Provider ---
# soal (production) | gemini
LLM_PROVIDER=soal

# --- Soal.help (OpenAI-compatible) ---
SOAL_API_KEY=
SOAL_BASE_URL=https://soal.help/api/v1
SOAL_MODEL=gemini-3.5-flash

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Embeddings ---
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004

# --- Limits ---
MAX_INPUT_CHARS=20000
MAX_OUTPUT_TOKENS=2000
MAX_RETRIES=2
REQUEST_TIMEOUT_SECONDS=180

# --- Matching weights ---
SKILL_WEIGHT=0.50
EXPERIENCE_WEIGHT=0.20
PROJECT_WEIGHT=0.15
EDUCATION_WEIGHT=0.10
SEMANTIC_WEIGHT=0.05

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
