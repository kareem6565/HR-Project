# Base URL of the FastAPI backend (the /api/v1 prefix is added by the client).
VITE_API_BASE_URL=http://localhost:8000

# Demo identity sent as X-Organization-Id / X-User-Id headers on every request.
# Paste a real org id and an active user id that exists in your database.
VITE_ORG_ID=
VITE_USER_ID=
