# --- HERA frontend configuration (frontend/frontend_last) ---
# Copy to .env and adjust for your environment. Vite exposes VITE_* vars to
# the browser at build/dev time; changing them requires a rebuild/restart.

# FastAPI backend API base URL (the /api/v1 prefix included).
# Defaults to same-origin /api/v1 (handled by Vite proxy in dev or Nginx in prod).
# For direct cross-origin dev set to http://localhost:8000/api/v1
VITE_API_BASE_URL=/api/v1